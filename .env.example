# Copy to .env and adjust. Every value below is the default unless noted;
# the test and simulation modes work without any keys.

# --- Web interface --------------------------------------------------------
BOT_DASHBOARD_HOST=127.0.0.1
BOT_DASHBOARD_PORT=3200

# --- Strategy (trend allocator) -------------------------------------------
BOT_STRATEGY_MODE=trend_allocator
# Add SOLUSDT to trade Solana too
BOT_ALLOCATOR_ASSETS=BTCUSDT,ETHUSDT
BOT_ALLOCATOR_SMA_PERIODS=20,50,100,200
BOT_ALLOCATOR_REBALANCE_THRESHOLD_PCT=0.1
BOT_ALLOCATOR_MIN_ORDER_USDT=10
BOT_ALLOCATOR_VOL_TARGET=0
BOT_ALLOCATOR_CHECK_INTERVAL_MS=300000
# Costs modelled in test mode (fee and slippage per side)
BOT_FEE_PCT=0.001
BOT_SLIPPAGE_PCT=0.0005

# --- Binance --------------------------------------------------------------
# Real account: spot trading only, never enable withdrawals
BINANCE_API_KEY=
BINANCE_API_SECRET=
BOT_ALLOW_LIVE_REAL=false
# Binance Demo account
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- Solana ---------------------------------------------------------------
# Wallet for real swaps: base58 secret key (Phantom export) or a JSON keypair file path
SOLANA_PRIVATE_KEY=
SOLANA_KEYPAIR_PATH=
BOT_ALLOW_SOLANA_REAL=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
SOLANA_SLIPPAGE_BPS=50
SOLANA_MAX_PRIORITY_FEE_LAMPORTS=500000
SOLANA_MIN_SOL_FOR_FEES=0.02
# Custom tokens: ASSET:mint:decimals, e.g. BTC:3NZ9JMVBmGAqocybic2c7LQCJScmgsAZ6vQqTDzcqmJh:8
SOLANA_TOKEN_MINTS=

# On-chain decision journal (Memo). Create the wallet with: npm run solana:proof-wallet
SOLANA_PROOF_ENABLED=false
SOLANA_PROOF_CLUSTER=devnet
SOLANA_PROOF_KEYPAIR_PATH=.solana/proof-keypair.json

# --- Diagnostic journal ---------------------------------------------------
BOT_LOG_DIR=logs
BOT_LOG_LEVEL=debug
BOT_LOG_RETENTION_DAYS=14
BOT_LOG_MAX_FILE_MB=10
